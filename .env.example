# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。

# ---- 必填 ----
# 唯一允许的 QQ 号（你自己的主号），其他人私聊一律静默忽略
ALLOW_USER_ID=
# DeepSeek API Key
MODEL_API_KEY=

# ---- 协议端（NapCat / LLOneBot）----
# 协议端 HTTP API 地址
ADAPTER_API=http://127.0.0.1:3001
# 协议端访问 token（没设就留空）
ADAPTER_TOKEN=

# ---- 模型 ----
# 公网可用：deepseek-flash（快、便宜）/ deepseek-v4-pro（更强、更慢）
MODEL_ID=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com

# ---- 本程序监听（接收协议端上报）----
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
# 启动后最多等多少秒让网络就绪（开机自启常比网络快）；0 = 不等
NETWORK_WAIT_SECONDS=30
# 每隔多少秒探一次协议端会话（QQ 内核掉线时 NapCat 仍报在线）；0 = 不探
ADAPTER_WATCHDOG_SECONDS=300

# ---- 主动消息（她先开口）----
PROACTIVE_ENABLED=true
# 每天最多几条
PROACTIVE_MAX_PER_DAY=3
# 只在几点到几点之间（左闭右开）
PROACTIVE_START_HOUR=9
PROACTIVE_END_HOUR=23
# 两条之间至少隔多久（小时）
PROACTIVE_MIN_GAP_HOURS=4
# 用户最近多少分钟内说过话就不开口
PROACTIVE_QUIET_MINUTES=30
# 多久没说话才考虑主动开口（小时）——默认 72 小时
PROACTIVE_IDLE_HOURS=72
# followup 每周最多几次
PROACTIVE_WEEKLY_MAX=1
# 多久检查一次（秒）
PROACTIVE_CHECK_SECONDS=600
# 未来事件过去几天还没发就作废（天）
PROACTIVE_EVENT_EXPIRE_DAYS=3

# ---- 对话行为 ----
REPLY_MAX_CHARS=300
SEGMENT_DELAY_MS=1500
HISTORY_MAX_TURNS=20
REQUEST_TIMEOUT=60

# ---- 长期记忆 ----
# 生活线：每天给她编一小份「今天」（做了什么/小麻烦/手边的东西/想提的事）
# 她随手甩表情包的概率（0 关闭），以及从哪些 tag 里挑
STICKER_CHANCE=0.12
STICKER_TAGS=happy,cute,hmm,thinking,sleepy,tired,ok
# 看电脑：只在 /screen、/pc 命令触发时执行
# 陪玩：她看你打游戏，隔一会儿说一句
REPLY_RESHAPE=true

# 上下文预算（token）：人设固定，其余按优先级分配，超了压最低优先级的
CONTEXT_TOKEN_BUDGET=9000

# 引用回复：把他引用的那句取出来喂进上下文（需要协议端支持 get_msg）
QUOTE_ENABLED=true

# 开场样品组数：消息列表最前面那几组对话，0 = 关掉
SAMPLE_PAIRS=8

# 前情摘要：窗口外的旧话压成两三句留着（会多一次模型调用，在后台跑）
RECAP_ENABLED=true

# 她此刻在干嘛：在打游戏/刷抖音的时候，几条才回一条是正常的
PRESENCE_ENABLED=true
BUSY_SKIP_CHANCE=0.55
BUSY_MAX_PENDING=3
# 忙完补回：晾着的话收工后要回，但不能追着回半小时前的
CATCHUP_ENABLED=true
CATCHUP_INTERVAL_SECONDS=20
BUSY_REPLY_AFTER_SECONDS=90
CATCHUP_MAX_AGE_SECONDS=1800
WATCH_ENABLED=true
WATCH_INTERVAL_SECONDS=75
WATCH_MINUTES=30
WATCH_MAX_LINES=20
SCREEN_ENABLED=true
SCREEN_DIR=data/screen
SCREEN_KEEP=20
LIFE_ENABLED=true
LIFE_DIR=data/life
LIFE_KEEP_DAYS=14
MEMORY_ENABLED=true
EXTRACT_ENABLED=true
# 权重半衰期：多少天衰减一半
DECAY_HALF_LIFE_DAYS=30
# 低于这个权重就不进上下文（不删除，只是沉底）
CARD_WEIGHT_THRESHOLD=0.15
# 每次注入的记忆卡预算
CARD_INJECT_TOKEN_BUDGET=1500
# 上下文超过软预算就压缩最旧的一段；硬预算是兜底上限
CONTEXT_SOFT_TOKEN_BUDGET=8000
CONTEXT_HARD_TOKEN_BUDGET=32000

# ---- 存储与人格 ----
DB_PATH=data/chat.db
SYSTEM_PROMPT_FILE=prompts/system.md
EXTRACT_PROMPT_FILE=prompts/extract.md
COMPACT_PROMPT_FILE=prompts/compact.md
LOG_DIR=logs

# ---- 配图 ----
# 最近 N 条消息内发过图，就忽略本次 {{img:tag}} 标记（默认 10）
IMAGE_ENABLED=true
# 内置占位图来源（启动时导入图库）
IMAGE_LIB_DIR=assets/seed-images
# 图库文件目录：内置图导入到这里，你发的表情包也存这里
IMAGE_DIR=data/images
# 自动收藏你发的表情包（只收表情包，普通照片不收）
IMAGE_COLLECT_ENABLED=true
# 用对话上下文猜标签（免费但一般；不准就用 /tag 手动打）
IMAGE_AUTO_TAG=true
# 图库容量上限；超出后从「无人工标签 + 最久未用」开始归档
IMAGE_MAX_COUNT=500
IMAGE_COOLDOWN_MESSAGES=10
# path 适合协议端与本程序同机；协议端在容器里看不到宿主路径时改 base64
IMAGE_SEND_MODE=path
IMAGE_MAX_BYTES=5242880
# ---- 看图（多模态）----
# 关掉之后她收图只当"表情"，不做识别
VISION_ENABLED=true
# 收件箱：他发来的图留一份，方便回看（放在项目目录里，不占 C 盘）
INBOX_DIR=data/inbox
INBOX_MAX_FILES=300

# ---- 画图（{{draw:…}}）----
# 关掉之后画图标记会被当普通文字处理，不会出图
DRAW_ENABLED=true
# pollinations：免费、不要 key，但免费额度里只剩 flux 一个模型
# openai：任意 OpenAI 兼容的 /images/generations 接口（画质明显更好，要自己的 key）
#   智谱（cogview-3-flash 有免费额度；会带「AI生成」标识，审核较严，
#     chibi/girl 这类词会被拦，代码会自动软化后重试）：
#     DRAW_PROVIDER=openai
#     DRAW_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     DRAW_MODEL=cogview-4
# 主模型挂了自动退到这个（便宜/免费），再不行退回 pollinations 免费版
DRAW_FALLBACK_MODEL=cogview-3-flash
# 负面提示词：智谱忽略，硅基流动这类支持 negative_prompt 的服务会吃
#DRAW_NEGATIVE=(worst quality, low quality:1.4), thick legs, 3d, watermark
#     DRAW_API_KEY=你的key
#   硅基流动：
#     DRAW_BASE_URL=https://api.siliconflow.cn/v1
#     DRAW_MODEL=Kwai-Kolors/Kolors
DRAW_PROVIDER=pollinations
DRAW_BASE_URL=
DRAW_API_KEY=
DRAW_MODEL=
DRAW_SIZE=1024
DRAW_TIMEOUT=90
# 画好的图落在这里，单独发过来
DRAW_DIR=data/drawn
# 两次画图之间的最小间隔（秒），防止刷图
DRAW_MIN_INTERVAL_SECONDS=300