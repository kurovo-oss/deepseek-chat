# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。

# ---- 必填 ----
# 唯一允许的 QQ 号（你自己的主号），其他人私聊一律静默忽略
ALLOW_USER_ID=
# DeepSeek API Key
MODEL_API_KEY=

# ---- 协议端（NapCat / LLOneBot）----
# 协议端 HTTP API 地址
ADAPTER_API=http://127.0.0.1:3001
# 协议端访问 token（没设就留空）
ADAPTER_TOKEN=

# ---- 模型 ----
# 公网可用：deepseek-flash（快、便宜）/ deepseek-v4-pro（更强、更慢）
MODEL_ID=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com

# ---- 本程序监听（接收协议端上报）----
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080

# ---- 对话行为 ----
REPLY_MAX_CHARS=300
SEGMENT_DELAY_MS=1500
HISTORY_MAX_TURNS=20
REQUEST_TIMEOUT=60

# ---- 长期记忆 ----
MEMORY_ENABLED=true
EXTRACT_ENABLED=true
# 权重半衰期：多少天衰减一半
DECAY_HALF_LIFE_DAYS=30
# 低于这个权重就不进上下文（不删除，只是沉底）
CARD_WEIGHT_THRESHOLD=0.15
# 每次注入的记忆卡预算
CARD_INJECT_TOKEN_BUDGET=1500
# 上下文超过软预算就压缩最旧的一段；硬预算是兜底上限
CONTEXT_SOFT_TOKEN_BUDGET=8000
CONTEXT_HARD_TOKEN_BUDGET=32000

# ---- 存储与人格 ----
DB_PATH=data/chat.db
SYSTEM_PROMPT_FILE=prompts/system.md
EXTRACT_PROMPT_FILE=prompts/extract.md
COMPACT_PROMPT_FILE=prompts/compact.md
LOG_DIR=logs

# ---- 配图 ----
# 最近 N 条消息内发过图，就忽略本次 {{img:tag}} 标记（默认 10）
IMAGE_ENABLED=true
IMAGE_LIB_DIR=assets/seed-images
IMAGE_COOLDOWN_MESSAGES=10
# path 适合协议端与本程序同机；协议端在容器里看不到宿主路径时改 base64
IMAGE_SEND_MODE=path
IMAGE_MAX_BYTES=5242880
