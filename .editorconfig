root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown 里行尾两个空格是有意义的硬换行，不要被编辑器吃掉
trim_trailing_whitespace = false

[*.{js,css,html,yml,yaml,json}]
indent_size = 2

[*.{bat,cmd,ps1}]
# cmd.exe 解析 LF-only 的 .bat 会截断命令，见 .gitattributes
end_of_line = crlf

[*.nsi]
charset = utf-8-bom
end_of_line = crlf
